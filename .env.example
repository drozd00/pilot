# Configuration for local moderated sessions. Dataset mode defaults to preflight.
# ANALYZER_DIR=../analyzer
POSTGRES_PASSWORD=local-thesis-only
POSTGRES_PORT=5432
APP_PORT=3000
DATASTORE_PORT=3001
# HOST applies to local development; production containers bind to 0.0.0.0.
HOST=127.0.0.1
STUDY_DATASET_KIND=preflight
# App-to-datastore HTTP connection outside Compose:
DATASTORE_URL=http://127.0.0.1:3001
# PostgreSQL connection for the datastore service and Python CLI outside Compose:
DATABASE_URL=postgresql://thesis:local-thesis-only@127.0.0.1:5432/thesis
